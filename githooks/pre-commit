#!/usr/bin/env bash
# Refuse staged files over 250 KB. Bulk receipts belong under artifacts/
# (ignored) or the nectar archive, with hashes in docs/bulk-receipts.sha256.
# Override a deliberate exception with: git commit --no-verify
limit=256000
status=0
git diff --cached --name-only --diff-filter=AM -z | while IFS= read -r -d '' f; do
  size=$(git cat-file -s ":$f")
  if [ "$size" -gt "$limit" ]; then
    echo "pre-commit: $f is $((size / 1024)) KB (limit 250 KB); keep bulk results out of Git." >&2
    exit 1
  fi
done || status=1
exit $status
